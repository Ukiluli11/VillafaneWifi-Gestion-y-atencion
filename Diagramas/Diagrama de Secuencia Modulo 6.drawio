        <mxCell id="alt_login_c2" value="&lt;font face=&quot;Times New Roman&quot;&gt;&lt;i&gt;[usuario activo — Validar hash de contraseña y autorizar sesión (RF-40, RF-44)]&lt;/i&gt;&lt;/font&gt;" style="text;html=1;fontSize=11;fontColor=#1E293B;align=left;verticalAlign=middle;" vertex="1" parent="1">
