        </mxCell>
    
        <mxCell id="m12" value="&lt;font face=&quot;Times New Roman&quot;&gt;UPDATE usuario SET ultimo_acceso = NOW()&lt;/font&gt;" style="endArrow=block;html=1;strokeColor=#0F172A;strokeWidth=1.3;fontSize=11.5;fontFamily=Times New Roman;fontColor=#0F172A;align=center;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
