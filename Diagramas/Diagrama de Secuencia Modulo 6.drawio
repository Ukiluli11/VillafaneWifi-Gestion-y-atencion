        <mxCell id="m6" value="&lt;font face=&quot;Times New Roman&quot;&gt;throw ValidationException('Credenciales inválidas o cuenta desactivada')&lt;/font&gt;" style="endArrow=open;dashed=1;html=1;strokeColor=#475569;strokeWidth=1.2;fontSize=11;fontFamily=Times New Roman;fontStyle=2;fontColor=#334155;align=center;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
