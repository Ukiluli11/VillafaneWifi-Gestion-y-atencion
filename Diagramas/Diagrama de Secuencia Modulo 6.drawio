        <!-- BANNER DE TITULO ESTANDARIZADO -->
        <mxCell id="title_banner" value="&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;DIAGRAMA DE SECUENCIA — MÓDULO 6: USUARIOS, AUTENTICACIÓN Y SEGURIDAD&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 13px; color: #475569;&quot;&gt;Autenticación Segura (Bcrypt), Verificación de Estado Activo y Control RBAC (RF-40 al RF-46)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
