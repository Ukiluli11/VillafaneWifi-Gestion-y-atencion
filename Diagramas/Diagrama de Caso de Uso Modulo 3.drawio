          <mxGeometry height="65" width="220" x="1530" y="550" as="geometry" />
        </mxCell>

        <mxCell id="cu_aprobar_pago" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" value="Aprobar comprobante y registrar pago" vertex="1">
          <mxGeometry height="65" width="220" x="1820" y="410" as="geometry" />
        </mxCell>

        <mxCell id="cu_rechazar_comp" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" value="Rechazar comprobante de pago" vertex="1">
          <mxGeometry height="65" width="220" x="1820" y="690" as="geometry" />
        </mxCell>

        <mxCell id="cu_imputar_cuotas" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="Imputar pago a cuotas pendientes" vertex="1">
          <mxGeometry height="65" width="220" x="1530" y="270" as="geometry" />
