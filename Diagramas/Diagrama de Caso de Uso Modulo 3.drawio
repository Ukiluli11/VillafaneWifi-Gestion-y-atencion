        <!-- Billetera Virtual -> Emitir comprobante -->
        <mxCell id="edge_act_billetera" edge="1" parent="1" source="actor_billetera" style="endArrow=none;html=1;strokeColor=#444;strokeWidth=1.5;" target="cu_emitir_comp" value="">
