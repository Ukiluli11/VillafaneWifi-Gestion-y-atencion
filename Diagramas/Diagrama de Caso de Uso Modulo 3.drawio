        <mxCell id="cu_motivo_rechazo" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" value="Registrar motivo de rechazo" vertex="1">
          <mxGeometry height="65" width="220" x="1530" y="800" as="geometry" />
