          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Aprobar pago -> «extend» -> Validar comp -->
        <mxCell id="edge_ext_aprobar" edge="1" parent="1" source="cu_aprobar_pago" style="dashed=1;endArrow=open;startArrow=none;html=1;fontSize=10;fontStyle=2;startFill=0;endFill=0;strokeColor=#996633;fontColor=#996633;" target="cu_validar_comp" value="«extend» [comprobante verificado y legítimo]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rechazar comp -> «extend» -> Validar comp -->
        <mxCell id="edge_ext_rechazar" edge="1" parent="1" source="cu_rechazar_comp" style="dashed=1;endArrow=open;startArrow=none;html=1;fontSize=10;fontStyle=2;startFill=0;endFill=0;strokeColor=#996633;fontColor=#996633;" target="cu_validar_comp" value="«extend» [comprobante inválido, apócrifo o inconsistente]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Aprobar pago -> «include» -> Imputar cuotas -->
        <mxCell id="edge_inc_imputar" edge="1" parent="1" source="cu_aprobar_pago" style="dashed=1;endArrow=open;startArrow=none;html=1;fontSize=10;fontStyle=2;startFill=0;endFill=0;strokeColor=#336699;fontColor=#336699;" target="cu_imputar_cuotas" value="«include»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Imputar cuotas -> «include» -> Actualizar saldo -->
        <mxCell id="edge_inc_saldo" edge="1" parent="1" source="cu_imputar_cuotas" style="dashed=1;endArrow=open;startArrow=none;html=1;fontSize=10;fontStyle=2;startFill=0;endFill=0;strokeColor=#336699;fontColor=#336699;" target="cu_actualizar_saldo" value="«include»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Aprobar pago -> «include» -> Notif aprobado -->
        <mxCell id="edge_inc_notif_aprob" edge="1" parent="1" source="cu_aprobar_pago" style="dashed=1;endArrow=open;startArrow=none;html=1;fontSize=10;fontStyle=2;startFill=0;endFill=0;strokeColor=#336699;fontColor=#336699;" target="cu_notif_aprobado" value="«include»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rechazar comp -> «include» -> Motivo de rechazo -->
        <mxCell id="edge_inc_motivo" edge="1" parent="1" source="cu_rechazar_comp" style="dashed=1;endArrow=open;startArrow=none;html=1;fontSize=10;fontStyle=2;startFill=0;endFill=0;strokeColor=#336699;fontColor=#336699;" target="cu_motivo_rechazo" value="«include»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rechazar comp -> «include» -> Notif rechazo -->
        <mxCell id="edge_inc_notif_rech" edge="1" parent="1" source="cu_rechazar_comp" style="dashed=1;endArrow=open;startArrow=none;html=1;fontSize=10;fontStyle=2;startFill=0;endFill=0;strokeColor=#336699;fontColor=#336699;" target="cu_notif_rechazo" value="«include»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gestionar cuentas -> «include» -> Registrar cuenta -->
        <mxCell id="edge_inc_reg_cuenta" edge="1" parent="1" source="cu_gestionar_cuentas" style="dashed=1;endArrow=open;startArrow=none;html=1;fontSize=10;fontStyle=2;startFill=0;endFill=0;strokeColor=#336699;fontColor=#336699;" target="cu_registrar_cuenta" value="«include»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
