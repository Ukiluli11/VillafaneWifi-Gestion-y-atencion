        <mxCell id="cu_notif_aprobado" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="Notificar acreditación de pago&#xa;por WhatsApp" vertex="1">
