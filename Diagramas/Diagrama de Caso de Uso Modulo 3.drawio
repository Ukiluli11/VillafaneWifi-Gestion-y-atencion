        <mxCell id="cu_actualizar_saldo" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="Actualizar saldo en cuenta corriente" vertex="1">
          <mxGeometry height="65" width="220" x="1230" y="180" as="geometry" />
