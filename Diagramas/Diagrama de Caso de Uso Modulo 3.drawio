<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.6.6 Chrome/144.0.7559.236 Electron/40.8.4 Safari/537.36" version="29.6.6">
  <diagram id="cu-modulo3" name="CU Módulo 3 - Gestión de Pagos y Comprobantes">
    <mxGraphModel dx="2491" dy="1609" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Límites del sistema -->
        <mxCell id="2" parent="1" style="text;html=1;strokeColor=#333;fillColor=#fafafa;align=center;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontStyle=1;fontSize=13;" value="Sistema de Gestión Villafañe Wifi — Módulo 3: Gestión de Pagos y Comprobantes" vertex="1">
          <mxGeometry height="1250" width="2040" x="190" y="35" as="geometry" />
        </mxCell>

        <!-- ACTORES -->
        <!-- Actor Cliente -->
        <mxCell id="actor_cliente" parent="1" style="shape=umlActor;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#333;" value="Cliente" vertex="1">
          <mxGeometry height="75" width="55" x="50" y="310" as="geometry" />
        </mxCell>

        <!-- Actor Billetera Virtual (Sistema Externo - Mercado Pago) -->
        <mxCell id="actor_billetera" parent="1" style="shape=umlActor;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;&lt;external&gt;&gt;&#xa;Billetera Virtual&#xa;(Mercado Pago)" vertex="1">
          <mxGeometry height="75" width="55" x="50" y="680" as="geometry" />
        </mxCell>

        <!-- Actor Empleado -->
        <mxCell id="actor_empleado" parent="1" style="shape=umlActor;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#333;" value="Empleado" vertex="1">
          <mxGeometry height="75" width="55" x="2270" y="460" as="geometry" />
        </mxCell>

        <!-- Actor Administrador -->
        <mxCell id="actor_admin" parent="1" style="shape=umlActor;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#333;" value="Dueño / Administrador" vertex="1">
          <mxGeometry height="75" width="55" x="2270" y="830" as="geometry" />
        </mxCell>

        <!-- CASOS DE USO: RECEPCIÓN Y BOT (Celestes) -->
        <mxCell id="cu_enviar_comp" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="Enviar comprobante de pago" vertex="1">
          <mxGeometry height="65" width="210" x="260" y="315" as="geometry" />
        </mxCell>

        <mxCell id="cu_procesar_ocr" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Procesar comprobante mediante OCR" vertex="1">
          <mxGeometry height="65" width="210" x="560" y="210" as="geometry" />
        </mxCell>

        <mxCell id="cu_verificar_dup" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Verificar duplicidad de comprobante&#xa;(Hash SHA-256)" vertex="1">
          <mxGeometry height="65" width="210" x="560" y="400" as="geometry" />
        </mxCell>

        <mxCell id="cu_solicitar_reenvio" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Solicitar reenvío de comprobante" vertex="1">
          <mxGeometry height="65" width="210" x="870" y="110" as="geometry" />
        </mxCell>

        <mxCell id="cu_alertar_duplicado" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" value="Alertar comprobante duplicado&#xa;(Aviso a Cliente y Empleado)" vertex="1">
          <mxGeometry height="65" width="210" x="870" y="400" as="geometry" />
        </mxCell>

        <!-- CASOS DE USO: BILLETERA VIRTUAL (Lavanda/Externo) -->
        <mxCell id="cu_emitir_comp" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Emitir comprobante de transferencia" vertex="1">
          <mxGeometry height="65" width="210" x="260" y="685" as="geometry" />
        </mxCell>

        <mxCell id="cu_proporcionar_trans" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Proporcionar datos de transacción&#xa;(N.º operación, fecha, monto)" vertex="1">
          <mxGeometry height="65" width="210" x="560" y="685" as="geometry" />
        </mxCell>

