          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Admin -> Validar -->
        <mxCell id="edge_adm_validar" edge="1" parent="1" source="actor_admin" style="endArrow=none;html=1;strokeColor=#444;strokeWidth=1.5;" target="cu_validar_comp" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Admin -> Historial -->
        <mxCell id="edge_adm_hist" edge="1" parent="1" source="actor_admin" style="endArrow=none;html=1;strokeColor=#444;strokeWidth=1.5;" target="cu_consultar_historial" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Admin -> Gestionar cuentas -->
        <mxCell id="edge_adm_cuentas" edge="1" parent="1" source="actor_admin" style="endArrow=none;html=1;strokeColor=#444;strokeWidth=1.5;" target="cu_gestionar_cuentas" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RELACIONES INCLUDE / EXTEND -->
        <!-- Enviar comp -> «include» -> Procesar OCR -->
        <mxCell id="edge_inc_ocr" edge="1" parent="1" source="cu_enviar_comp" style="dashed=1;endArrow=open;startArrow=none;html=1;fontSize=10;fontStyle=2;startFill=0;endFill=0;strokeColor=#336699;fontColor=#336699;" target="cu_procesar_ocr" value="«include»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Enviar comp -> «include» -> Verificar dup -->
        <mxCell id="edge_inc_dup" edge="1" parent="1" source="cu_enviar_comp" style="dashed=1;endArrow=open;startArrow=none;html=1;fontSize=10;fontStyle=2;startFill=0;endFill=0;strokeColor=#336699;fontColor=#336699;" target="cu_verificar_dup" value="«include»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Solicitar reenvio -> «extend» -> Procesar OCR -->
        <mxCell id="edge_ext_reenvio" edge="1" parent="1" source="cu_solicitar_reenvio" style="dashed=1;endArrow=open;startArrow=none;html=1;fontSize=10;fontStyle=2;startFill=0;endFill=0;strokeColor=#996633;fontColor=#996633;" target="cu_procesar_ocr" value="«extend» [OCR no concluyente / baja confianza]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Alertar duplicado -> «extend» -> Verificar dup -->
        <mxCell id="edge_ext_alerta_dup" edge="1" parent="1" source="cu_alertar_duplicado" style="dashed=1;endArrow=open;startArrow=none;html=1;fontSize=10;fontStyle=2;startFill=0;endFill=0;strokeColor=#996633;fontColor=#996633;" target="cu_verificar_dup" value="«extend» [hash SHA-256 ya registrado]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Emitir comp -> «include» -> Proporcionar datos -->
        <mxCell id="edge_inc_billetera_datos" edge="1" parent="1" source="cu_emitir_comp" style="dashed=1;endArrow=open;startArrow=none;html=1;fontSize=10;fontStyle=2;startFill=0;endFill=0;strokeColor=#336699;fontColor=#336699;" target="cu_proporcionar_trans" value="«include»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Validar comp -> «include» -> Visualizar bandeja -->
