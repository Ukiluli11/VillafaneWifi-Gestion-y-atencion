        <mxCell id="cu_consultar_historial" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="Consultar historial de pagos&#xa;y comprobantes" vertex="1">
          <mxGeometry height="65" width="220" x="1820" y="920" as="geometry" />
        </mxCell>

        <mxCell id="cu_gestionar_cuentas" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" value="Gestionar cuentas receptoras" vertex="1">
          <mxGeometry height="65" width="220" x="1820" y="1080" as="geometry" />
        </mxCell>

        <mxCell id="cu_registrar_cuenta" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" value="Registrar cuenta bancaria / virtual" vertex="1">
          <mxGeometry height="65" width="220" x="1450" y="1080" as="geometry" />
        </mxCell>

        <!-- CONEXIONES ACTORES -->
        <!-- Cliente -> Enviar comprobante -->
        <mxCell id="edge_act_cliente" edge="1" parent="1" source="actor_cliente" style="endArrow=none;html=1;strokeColor=#444;strokeWidth=1.5;" target="cu_enviar_comp" value="">
