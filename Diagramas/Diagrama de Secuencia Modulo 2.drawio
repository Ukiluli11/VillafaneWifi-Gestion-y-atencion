        <!-- NOTA AL PIE METODOLÓGICA (ARQUITECTURA BCE) -->
        <mxCell id="nota_bce" parent="1" style="text;html=1;fontSize=9;fontStyle=2;fillColor=#F5F5F5;strokeColor=#CCCCCC;align=left;spacing=8;whiteSpace=wrap;" value="Nota Metodológica de Arquitectura BCE (Boundary - Control - Entity) para el Módulo 2:&#xa;• Boundary: WebhookWhatsappController recibe y valida las solicitudes entrantes de la API oficial de WhatsApp Cloud API, y el Panel Web permite la interacción del Empleado.&#xa;• Control / Dominio: ServicioConversaciones, ServicioIdentificacion y IAService encapsulan las reglas de negocio (orquestación del chat, identificación de clientes, clasificación de intenciones y derivación humana).&#xa;• Entity: La Base de Datos MariaDB persiste las entidades Conversación, Mensaje, Cliente, Cuota, Ticket y Comprobante, manteniendo la integridad referencial y trazabilidad requerida por los requerimientos RF-10 al RF-19." vertex="1">
          <mxGeometry height="95" width="1860" x="40" y="3030" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
