[Unit]
Description=Tareas programadas de Villafane Wifi
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/srv/villafane-wifi/current
ExecStart=/usr/bin/php artisan schedule:run --no-interaction
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
TimeoutStartSec=300
