# Reemplazar DEMO_HOST y PHP_FPM_SOCKET antes de instalar este sitio.
# Certbot agrega HTTPS a esta configuración después de validar el dominio.
server {
    listen 80;
    listen [::]:80;
    server_name DEMO_HOST;
    root /srv/villafane-wifi/current/public;
    index index.php;
    charset utf-8;
    client_max_body_size 12m;

    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        try_files $uri =404;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt { access_log off; log_not_found off; }
    location ^~ /storage/comprobantes/ { return 404; }
    error_page 404 /index.php;

    location ~ ^/index\.php(/|$) {
        include fastcgi_params;
        fastcgi_pass unix:PHP_FPM_SOCKET;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_read_timeout 60s;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known).* { deny all; }
}
