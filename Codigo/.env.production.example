APP_NAME="Villafañe Wifi — Demostración"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=villafane_wifi
DB_USERNAME=villafane_app
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# Vacio permite responder a cualquier numero; una lista limita los destinatarios.
# Los recordatorios tienen su propia lista de destinatarios autorizados.
WHATSAPP_DESTINATARIOS_PERMITIDOS=
WHATSAPP_MODO_SIMULACION=false
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_VALIDAR_FIRMA=true
WHATSAPP_MEDIA_DISK=local
WHATSAPP_MEDIA_MAX_KB=10240
WHATSAPP_TEMPLATE_VENCIMIENTO=recordatorio_vencimiento
WHATSAPP_TEMPLATE_VENCIDA=recordatorio_cuota_vencida
WHATSAPP_TEMPLATE_LANGUAGE=es_AR
WHATSAPP_RECORDATORIOS_HABILITADOS=false
# Lista exclusiva para recordatorios; vacia bloquea los envios reales programados.
WHATSAPP_RECORDATORIOS_DESTINATARIOS=
WHATSAPP_CONTROL_CONSUMO_HABILITADO=true
WHATSAPP_LIMITE_SERVICIOS_MES=900
WHATSAPP_PLANTILLAS_REALES_HABILITADAS=false
WHATSAPP_PLANTILLAS_DESTINATARIOS=
WHATSAPP_LIMITE_PLANTILLAS_MES=4
WHATSAPP_LIMITE_PLANTILLAS_DIA=2

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=15
IA_CONFIANZA_MINIMA=0.65

# M3: instalar Tesseract (spa+eng), Poppler y el trabajador de la cola antes de activar.
OCR_HABILITADO=false
TESSERACT_BIN=/usr/bin/tesseract
PDFTOPPM_BIN=/usr/bin/pdftoppm
OCR_TIMEOUT=25
COMPROBANTES_NOTIFICAR_RESULTADO=false
COMPROBANTES_PLANTILLAS_FUERA_VENTANA=false
WHATSAPP_TEMPLATE_PAGO_APROBADO=demo_pago_aprobado_v1
WHATSAPP_TEMPLATE_PAGO_RECHAZADO=demo_pago_rechazado_v1
TRANSFERENCIAS_HABILITADAS=false
TRANSFERENCIAS_ID_CUENTA=0

# Avisos de tickets: solo dentro de las 24 horas y sujetos al control de consumo.
TICKETS_NOTIFICAR_RESULTADO=false
