APP_NAME="Villafañe Wifi — Demostración"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=villafane_wifi
DB_USERNAME=villafane_app
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# Vacio permite responder a cualquier numero; una lista limita los destinatarios.
# En la demo abierta mantener desactivados los recordatorios automaticos.
WHATSAPP_DESTINATARIOS_PERMITIDOS=
WHATSAPP_MODO_SIMULACION=false
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_VALIDAR_FIRMA=true
WHATSAPP_MEDIA_DISK=local
WHATSAPP_MEDIA_MAX_KB=10240
WHATSAPP_TEMPLATE_VENCIMIENTO=recordatorio_vencimiento
WHATSAPP_TEMPLATE_VENCIDA=recordatorio_cuota_vencida
WHATSAPP_TEMPLATE_LANGUAGE=es_AR

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=15
IA_CONFIANZA_MINIMA=0.65
